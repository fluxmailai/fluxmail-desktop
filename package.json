{
  "name": "fluxmail-desktop",
  "version": "0.7.0",
  "private": true,
  "description": "Fluxmail desktop email client",
  "license": "MPL-2.0",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "build": "electron-forge package",
    "make": "electron-forge make",
    "release:notes": "node scripts/release-notes.mjs",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "lint": "oxlint src tests scripts",
    "format": "oxfmt \"src/**/*\" \"tests/**/*\" \"scripts/**/*.mjs\" README.md CHANGELOG.md \"docs/**/*\" \".github/**/*\" \"*.json\" \"*.ts\" \"*.html\" \"*.css\"",
    "format:check": "oxfmt --check \"src/**/*\" \"tests/**/*\" \"scripts/**/*.mjs\" README.md CHANGELOG.md \"docs/**/*\" \".github/**/*\" \"*.json\" \"*.ts\" \"*.html\" \"*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "test:watch": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs",
    "test:e2e": "electron-forge package && playwright test",
    "postinstall": "install-electron && electron-rebuild -f -w better-sqlite3",
    "commitlint": "commitlint",
    "prepare": "node -e \"if (!process.env.CI && process.env.NODE_ENV !== 'production' && require('node:fs').existsSync('.git')) import('husky').then(({ default: husky }) => husky())\""
  },
  "dependencies": {
    "@fluxmail/core": "0.15.0",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "better-sqlite3": "12.11.1",
    "colord": "^2.9.3",
    "dompurify": "^3.4.3",
    "fluxmail": "0.15.0",
    "google-auth-library": "10.5.0",
    "lucide-react": "^0.468.0",
    "parse5": "8.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-virtuoso": "^4.18.7",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "4.2.0",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.1.1",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.8.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@11.9.0",
  "productName": "Fluxmail"
}
